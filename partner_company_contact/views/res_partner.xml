<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <field name="vat" position="before">
                <field name="display_use_parent_company_name" invisible="1" />
                <field
                    name="use_parent_company_name"
                    attrs="{'invisible': [('display_use_parent_company_name', '=', False)]}"
                />
                <field
                    name="company"
                    attrs="{'invisible': ['|', ('use_parent_company_name', '=', True), ('parent_id', '=', False)]}"
                />
            </field>
        </field>
    </record>

</odoo>
